pairs(emmApstrade)
#Kontrole būtiski augstāka par hito, sub un hito_sub (p=0.002,p<0.001, p<0.001). Hito > sub (p=0.009). Hito_sub>sub tuvu būtiskumam (p=0.056).
emmSubstr <- emmeans(glm_ef, ~ substrate)
pairs_subs <- pairs(emmSubstr, adjust = "tukey")
