geom_point() +
labs(x = "density", y = "max stipr", fill = "apstrade")
cor.test(liece_sub_full$max_stipr_σf_m,liece_sub_full$density,method="spearman")
#Pastāv vidēji stipra statistiski būtiska pozitīva korelācija starp materiāla blīvumu un lieces stiprību (R=0.468, p<0.001).
#Models
glm_stipr <- glm(max_stipr_σf_m ~ apstrade + substrate + density, family = gaussian(link = "identity"), data = liece_sub_full)
glm_stipr1 <- glm(max_stipr_σf_m ~ apstrade + substrate + init_density, family = gaussian(link = "identity"), data = liece_sub_full)
glm_stipr2 <- glm(max_stipr_σf_m ~ apstrade + substrate, family = gaussian(link = "identity"), data = liece_sub_full)
glm_gamma_stipr <- glm(max_stipr_σf_m ~ apstrade + substrate + density,
family = Gamma(link = "log"),
data = liece_sub_full)
glm_gamma_stipr1 <- glm(max_stipr_σf_m ~ apstrade + substrate + init_density,
family = Gamma(link = "log"),
data = liece_sub_full)
glm_gamma_stipr2 <- glm(max_stipr_σf_m ~ apstrade + substrate,
family = Gamma(link = "log"),
data = liece_sub_full)
AIC(glm_stipr, glm_stipr1,glm_stipr2,glm_gamma_stipr,glm_gamma_stipr1,glm_gamma_stipr2)
plot(residuals(glm_gamma_stipr1))
qqnorm(residuals(glm_gamma_stipr1))
qqline(residuals(glm_gamma_stipr1))
summary(glm_gamma_stipr1)
#Visi apstrādes veidi būtiski paaugstina lieces stiprību, pastāv atšķirības starp dažādiem substrātiem.
emmApstrade <- emmeans(glm_gamma_stipr1, ~ apstrade)
pairs(emmApstrade)
#sub un sub_hito apstrādei ir būtiski augstāka lieces stiprība, nekā kontrolei un hito (p<0/001). Hito ir tendence paaugstināt max stipr, salīdzinot ar kontroli (p=0.18)
pairs_subs <- pairs(emmSubstr, adjust = "tukey") #Substrāta modelī neiekļaujblīvumu, jo tās uzskatāms par substrātu raksturojošu īpašību.
pairs_df <- as.data.frame(pairs_subs)
sig_pairs_subs <- subset(pairs_df, p.value < 0.05)
sig_pairs_subs
#BSD4 atšķiras no visiem pārējiem substrātiem tam ir augstāka max stiprība nekā WS1un WS4,bet zemāka par pārējiem.
#WS1 un WS4 ir zemāki pr visiem pārējiem paraugiem. BSD2 un WS3 ir augstāks par WS2.
plot(allEffects(glm_gamma_stipr1))
plot(allEffects(glm_gamma_stipr2))
