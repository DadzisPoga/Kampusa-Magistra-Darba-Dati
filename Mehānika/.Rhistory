summary(glm_stipr)
#Hitozāns būtiski (p<0.001) palielina specifisko stiprību, Suberīnskābes nē, bet tuvu būtiskumam (p=0.051).
emmApstrade <- emmeans(glm_stipr, ~ apstrade)
pairs(emmApstrade)
#Hito apstrāde palielina lieces stiprību salīdzinot ar kontroli (p=0.003)
emmSubstr <- emmeans(glm_stipr, ~ substrate)
pairs_subs <- pairs(emmSubstr, adjust = "tukey") #Substrāta modelī neiekļaujblīvumu, jo tās uzskatāms par substrātu raksturojošu īpašību.
pairs_df <- as.data.frame(pairs_subs)
sig_pairs_subs <- subset(pairs_df, p.value < 0.05)
sig_pairs_subs
