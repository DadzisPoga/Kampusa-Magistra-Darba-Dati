#Attēli----
##Max stip----
library(patchwork)
# Calculate max y
max_y <- max(c(liece_sub_full$max_stipr_σf_m, liece_sub_summary$mean_max_stipr_σf_m + liece_sub_summary$sd_max_stipr_σf_m))
# Create a shared Y-axis scale so grid lines match perfectly
shared_y_axis <- scale_y_continuous(limits = c(0, max_y), expand = expansion(mult = c(0, 0.05)))
# Calculate stats
res <- cor.test(liece_sub_full$max_stipr_σf_m, liece_sub_full$density, method = "spearman")
# Format p-value to show "< 0.001" instead of "0.000"
p_val_text <- ifelse(res$p.value < 0.001, "< 0.001", sprintf("= %.3f", res$p.value))
label_txt <- sprintf("r = %.2f\np %s", res$estimate, p_val_text)
# --- PLOT 1 ---
sigmaDens <- ggplot(liece_sub_full, aes(x = density, y = max_stipr_σf_m)) +
geom_smooth(method = "lm", color = "black", se = TRUE) +
geom_point(aes(shape = apstrade, colour = substrate)) +
labs(x = expression(Blīvums ~ (g %*% cm^-3)),
y = expression("Lieces stiprība," ~ sigma[fM] ~ "(MPa)"),
shape = NULL, color = NULL) +
theme_bw() +
theme(
axis.title = element_text(size = 12),
legend.position = "right",
legend.justification = c(1, 1),
legend.text = element_text(size = 10),
legend.title = element_text(size = 12),
legend.background = element_rect(fill = NA),
legend.direction = "vertical",
legend.box = "vertical",
legend.margin = margin(0, 0, 0, 0),
legend.key.height = unit(0.5, "cm"),
legend.key.width = unit(0.3, "cm"),
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10)
) +
guides(
shape = guide_legend(title = "Apstrāde:"),
colour = guide_legend(title = "Substrāts:")
) +
annotate("text",
x = -Inf, y = Inf,
label = label_txt,
hjust = -0.1, vjust = 1.2,
size = 3.5) +
scale_color_manual(values = c(
"B–Kl" = "#00F", "B–Kl–K" = "#F00",
"B–Kl–Z" = "#0A0", "B" = "#eb0",
"S–Kl" = "#000", "S–Kl–K" = "#F0e",
"S–Kl–Z" = "#099", "S" = "#970"
)) +
scale_shape_manual(values = c(
"Kontrole" = 1,
"Hitozāns"   = 0,
"Suberīnskābes"   = 4,
"Hitozāns + Suberīnskābes"   = 2
)) +
shared_y_axis
sigmaDens
ggsave("sigmaliecedensSub.png", plot = sigmaDens, width = 6, height = 3.5, units = "in", dpi = 120)
# --- PLOT 2 ---
sigmal <- ggplot(liece_sub_summary, aes(x = substrate, y = mean_max_stipr_σf_m, fill = apstrade)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.7), color = "black", width = 0.7) +
geom_errorbar(aes(ymin = mean_max_stipr_σf_m - sd_max_stipr_σf_m,
ymax = mean_max_stipr_σf_m + sd_max_stipr_σf_m),
width = 0.2, position = position_dodge(0.7)) +
labs(x = NULL,  y = expression("Lieces stiprība," ~ sigma[fM] ~ "(MPa)"), fill = NULL) +
theme_bw() +
theme(
axis.title = element_text(size = 12),
axis.text.x = element_text(size = 10, angle = 90, vjust = 0.5, hjust = 1),
axis.text.y = element_text(size = 10),
panel.spacing = unit(1, "lines"),
panel.grid.major = element_line(color = "grey90"),
panel.grid.minor = element_blank(),
legend.position = "top",
legend.justification = c(0, 1),
legend.text = element_text(size = 10),
legend.title = element_text(size = 12),
legend.background = element_rect(fill = NA),
legend.direction = "horizontal",
legend.key.size = unit(0.4, "cm") # <--- Makes the colored legend boxes smaller
) +
guides(fill = guide_legend(nrow = 1, title = NULL)) +
scale_fill_manual(values = c("Kontrole" = "#e04", "Hitozāns" = "#eb0",
"Suberīnskābes" = "#00a", "Hitozāns + Suberīnskābes" = "#0dd"))
ggsave("sigmalieceSub.png", plot = sigmal, width = 7, height = 3.5, units = "in", dpi = 120)
# --- COMBINE PLOTS ---
# plot_annotation(tag_levels = 'A') automatically adds A and B to the top corners
# Calculate max y
max_y <- max(c(spiede_sub_full$stipriba_σ10, spiede_sub_summary$mean_stipriba_σ10 + spiede_sub_summary$sd_stipriba_σ10))
# Create a shared Y-axis scale so grid lines match perfectly
shared_y_axis <- scale_y_continuous(limits = c(0, max_y), expand = expansion(mult = c(0, 0.05)))
# Calculate stats
res <- cor.test(spiede_sub_full$stipriba_σ10, spiede_sub_full$density, method = "spearman")
# Format p-value to show "< 0.001" instead of "0.000"
p_val_text <- ifelse(res$p.value < 0.001, "< 0.001", sprintf("= %.3f", res$p.value))
label_txt <- sprintf("r = %.2f\np %s", res$estimate, p_val_text)
# --- PLOT 1 ---
sigma10Dens <- ggplot(spiede_sub_full, aes(x = density, y = stipriba_σ10)) +
geom_smooth(method = "lm", color = "black", se = TRUE) +
geom_point(aes(shape = apstrade, colour = substrate)) +
labs(x = expression(Blīvums ~ (g %*% cm^-3)),
y = expression("Spiedes stiprība, " ~ sigma[10] ~ "(MPa)"),
shape = NULL, color = NULL) +
theme_bw() +
theme(
axis.title = element_text(size = 12),
legend.position = "right",
legend.justification = c(1, 1),
legend.text = element_text(size = 10),
legend.title = element_text(size = 12),
legend.background = element_rect(fill = NA),
legend.direction = "vertical",
legend.box = "vertical",
legend.margin = margin(0, 0, 0, 0),
legend.key.height = unit(0.5, "cm"),
legend.key.width = unit(0.3, "cm"),
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10)
) +
guides(
shape = guide_legend(title = "Apstrāde:"),
colour = guide_legend(title = "Substrāts:")
) +
annotate("text",
x = -Inf, y = Inf,
label = label_txt,
hjust = -0.1, vjust = 1.2,
size = 3.5) +
scale_color_manual(values = c(
"B–Kl" = "#00F", "B–Kl–K" = "#F00",
"B–Kl–Z" = "#0A0", "B" = "#eb0",
"S–Kl" = "#000", "S–Kl–K" = "#F0e",
"S–Kl–Z" = "#099", "S" = "#970"
)) +
scale_shape_manual(values = c(
"Kontrole" = 1,
"Hitozāns"   = 0,
"Suberīnskābes"   = 4,
"Hitozāns + Suberīnskābes"   = 2
)) +
shared_y_axis
sigma10Dens
ggsave("sigmaSpiededensSub.png", plot = sigma10Dens, width = 6, height = 3.5, units = "in", dpi = 120)
sigma10 <- ggplot(spiede_sub_summary, aes(x = substrate, y = mean_stipriba_σ10, fill = apstrade)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.7), color = "black", width = 0.7) +
geom_errorbar(aes(ymin = mean_stipriba_σ10 - sd_stipriba_σ10,
ymax = mean_stipriba_σ10 + sd_stipriba_σ10),
width = 0.2, position = position_dodge(0.7)) +
labs(x = NULL,  y = expression("Spiedes stiprība," ~ sigma[10] ~ "(MPa)"), fill = NULL) +
theme_bw() +
theme(
axis.title = element_text(size = 12),
axis.text.x = element_text(size = 10, angle = 90, vjust = 0.5, hjust = 1),
axis.text.y = element_text(size = 10),
panel.spacing = unit(1, "lines"),
panel.grid.major = element_line(color = "grey90"),
panel.grid.minor = element_blank(),
legend.position = "top",
legend.justification = c(0, 1),
legend.text = element_text(size = 10),
legend.title = element_text(size = 12),
legend.background = element_rect(fill = NA),
legend.direction = "horizontal",
legend.key.size = unit(0.4, "cm") # <--- Makes the colored legend boxes smaller
) +
guides(fill = guide_legend(nrow = 1, title = NULL)) +
scale_fill_manual(values = c("Kontrole" = "#e04", "Hitozāns" = "#eb0",
"Suberīnskābes" = "#00a", "Hitozāns + Suberīnskābes" = "#0dd"))
sigma10
ggsave("sigmaspiedeSub.png", plot = sigma10, width = 7, height = 3.5, units = "in", dpi = 120)
