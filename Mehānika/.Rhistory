#noraidu normalitāti
#Blivums
ggplot(liece_sub_full, aes(x = density, y = ef_spec)) +
geom_point() +
labs(x = "density", y = "max stipr", fill = "apstrade")
cor.test(liece_sub_full$ef_spec,liece_sub_full$density,method="spearman")
#Hmm, joprojām vērojama vājakorelācija (R=0.371,p<0.001)
#Models
glm_ef <- glm(ef_spec ~ apstrade + substrate, family = gaussian(link = "identity"), data = liece_sub_full)
glm_gamma_ef <- glm(ef_spec ~ apstrade + substrate,
family = Gamma(link = "log"),
data = liece_sub_full)
AIC(glm_ef, glm_gamma_ef)
plot(residuals(glm_gamma_ef))
qqnorm(residuals(glm_gamma_ef))
qqline(residuals(glm_gamma_ef))
#ir OK
summary(glm_gamma_ef)
#Būtiska ietekme gan hitozānam (p=0.01), gan sub (p<0.001), gan abu kombinācijai(p=0.003). Substrāti 'būtiski ietekmē (p<0.05).
emmApstrade <- emmeans(glm_gamma_ef, ~ apstrade)
pairs(emmApstrade)
#Kontrole būtiski zemāka par sub un hito sub. hito < sub un hito sub (p<0.001).
emmSubstr <- emmeans(glm_gamma_ef, ~ substrate)
pairs_subs <- pairs(emmSubstr, adjust = "tukey") #Substrāta modelī neiekļaujblīvumu, jo tās uzskatāms par substrātu raksturojošu īpašību.
pairs_df <- as.data.frame(pairs_subs)
sig_pairs_subs <- subset(pairs_df, p.value < 0.05)
sig_pairs_subs
#BSD2>BSD3,BSD4,WS1,WS2,WS4. BSD1,WS2 un WS3 >BSD4,WS1,WS4.BSD3 un BSD4 >WS4 (p<0.05).
plot(allEffects(glm_gamma_ef))
